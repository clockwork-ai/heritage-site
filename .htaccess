# CALLUM.B on Apache / cPanel.
# Clean URLs, and the old free-guide address.
DirectoryIndex index.html
Options -Indexes +FollowSymLinks
RewriteEngine On

# Emails already sent still use this path. Send them to the new guide.
# The file at the old path is the same PDF, if this rewrite is not applied.
RewriteRule ^guides/five-numbers\.pdf$ /guides/the-five-foundations.pdf [R=301,L]

# /about/ -> /about when about.html exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /about -> about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# /start -> /start/ when it is a directory
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
