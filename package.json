{
  "name": "callumb-heritage-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "serve": "node serve.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:desktop": "playwright test --project=desktop",
    "test:phone": "playwright test --project=phone",
    "test:chat": "node --experimental-strip-types --test lib/*.test.ts server/*.test.ts",
    "report": "playwright show-report",
    "build": "python3 tools/build_pages.py && python3 tools/version_assets.py",
    "build:chat": "node scripts/build.mjs",
    "build:cpanel": "node scripts/cpanel.mjs",
    "typecheck": "tsc --noEmit",
    "test:live": "BASE_URL=https://callumbcoaching.co.uk playwright test"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "ai": "^7.0.152",
    "playwright-core": "^1.47.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^24.19.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
