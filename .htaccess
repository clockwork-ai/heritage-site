# CALLUM.B on Apache / cPanel.
# Clean URLs, and the old free-guide address.
DirectoryIndex index.html
Options -Indexes +FollowSymLinks
RewriteEngine On

# Retired offers. The coaching is The Full Rebuild.
RewriteRule ^pricing/?$ /rebuild [R=301,L]
RewriteRule ^start/?$ /rebuild [R=301,L]
RewriteRule ^os-setup/?$ /rebuild [R=301,L]
RewriteRule ^the-ninety/?$ /rebuild [R=301,L]
RewriteRule ^muscle/?$ /rebuild [R=301,L]
RewriteRule ^magnum-opus/?$ /rebuild [R=301,L]
RewriteRule ^physique-os/?$ /rebuild [R=301,L]
RewriteRule ^head-start/?$ /rebuild [R=301,L]
RewriteRule ^headstart/?$ /rebuild [R=301,L]
RewriteRule ^the-head-start/?$ /rebuild [R=301,L]
RewriteRule ^new-year-head-start/?$ /rebuild [R=301,L]
RewriteRule ^head-start-challenge/?$ /rebuild [R=301,L]
RewriteRule ^8-week/?$ /rebuild [R=301,L]
RewriteRule ^8-week-challenge/?$ /rebuild [R=301,L]
RewriteRule ^8-week-guarantee/?$ /rebuild [R=301,L]
RewriteRule ^eight-week/?$ /rebuild [R=301,L]
RewriteRule ^eight-week-challenge/?$ /rebuild [R=301,L]
RewriteRule ^challenge/?$ /rebuild [R=301,L]
RewriteRule ^the-standard/?$ /rebuild [R=301,L]
RewriteRule ^standard/?$ /rebuild [R=301,L]
RewriteRule ^the-90/?$ /rebuild [R=301,L]
RewriteRule ^the90/?$ /rebuild [R=301,L]
RewriteRule ^ninety/?$ /rebuild [R=301,L]
RewriteRule ^90-day/?$ /rebuild [R=301,L]
RewriteRule ^foundation/?$ /rebuild [R=301,L]
RewriteRule ^transformation/?$ /rebuild [R=301,L]
RewriteRule ^structured/?$ /rebuild [R=301,L]
RewriteRule ^physique/?$ /rebuild [R=301,L]
RewriteRule ^physiqueos/?$ /rebuild [R=301,L]
RewriteRule ^magnum/?$ /rebuild [R=301,L]
RewriteRule ^opus/?$ /rebuild [R=301,L]

# Emails already sent still use this path. Send them to the new guide.
# The file at the old path is the same PDF, if this rewrite is not applied.
RewriteRule ^guides/five-numbers\.pdf$ /guides/the-five-foundations.pdf [R=301,L]

# /about/ -> /about when about.html exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /about -> about.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# /start -> /start/ when it is a directory
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]
