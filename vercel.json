{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/lead.php", "destination": "/api/lead" },
    { "source": "/bf-api.php", "destination": "/api/bf" }
  ],
  "redirects": [
    { "source": "/guides/five-numbers.pdf", "destination": "/guides/the-five-foundations.pdf", "permanent": true }
  ],
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30
    },
    "api/bf.js": {
      "maxDuration": 30
    },
    "api/apply.js": {
      "maxDuration": 15
    }
  }
}
